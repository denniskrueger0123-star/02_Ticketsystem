# Kopie als .env anlegen und Werte anpassen. Bereits gesetzte Umgebungsvariablen haben Vorrang.

# Port des Servers (Standard 3000)
# PORT=3000

# Automatische Projekt-Backups (eine Datei pro Projekt im Export-Format,
# wiederherstellbar über "Projekt importieren")
# Zielordner, relativ zum Projektordner oder absolut (Standard: backups)
BACKUP_DIR=backups
# Intervall in Minuten, 0 = aus (Standard: 60)
BACKUP_INTERVAL=60
# Anzahl Backups, die pro Projekt erhalten bleiben (Standard: 10)
BACKUP_KEEP=10
